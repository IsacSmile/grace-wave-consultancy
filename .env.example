# Neon Postgres Connection String (Server-side ONLY; Never prefix with VITE_)
# Get this from your Neon console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require

# Salt for hashing IP addresses for hourly rate-limiting
RATE_LIMIT_SALT=grace_way_accounting_salt_change_me_in_prod
